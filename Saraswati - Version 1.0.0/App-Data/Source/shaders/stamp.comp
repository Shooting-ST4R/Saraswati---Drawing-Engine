#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

// Transform tool: draws a floating image (set 2, straight alpha) into the layer through an
// inverse homography (document px -> source px), bilinear filtered, Normal blend.
layout(set = 2, binding = 0, rgba8) uniform readonly image2D srcImg;

layout(push_constant) uniform StampPC {
  ivec2 origin;
  ivec2 size;
  vec4 h0;
  vec4 h1;
  vec4 h2;
} pc;

vec4 srcTexel(ivec2 p) {
  ivec2 s = imageSize(srcImg);
  if (any(lessThan(p, ivec2(0))) || any(greaterThanEqual(p, s))) return vec4(0.0);
  vec4 c = imageLoad(srcImg, p);
  return vec4(c.rgb * c.a, c.a);
}

void main() {
  ivec2 local = ivec2(gl_GlobalInvocationID.xy);
  if (local.x >= pc.size.x || local.y >= pc.size.y) return;
  ivec2 px = pc.origin + local;
  vec3 d = vec3(vec2(px) + 0.5, 1.0);
  vec3 q = vec3(dot(pc.h0.xyz, d), dot(pc.h1.xyz, d), dot(pc.h2.xyz, d));
  if (q.z <= 1e-9) return;
  vec2 s = q.xy / q.z - 0.5;
  ivec2 i = ivec2(floor(s));
  vec2 f = s - vec2(i);
  vec4 a = mix(srcTexel(i), srcTexel(i + ivec2(1, 0)), f.x);
  vec4 b = mix(srcTexel(i + ivec2(0, 1)), srcTexel(i + ivec2(1, 1)), f.x);
  vec4 c = mix(a, b, f.y);
  if (c.a <= 0.0) return;
  vec4 dst = imageLoad(layerImg, px);
  imageStore(layerImg, px, c + dst * (1.0 - c.a));
}
